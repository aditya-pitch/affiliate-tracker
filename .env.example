APP_NAME="Pitch Innovations Affiliates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=affiliate_tracker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=20
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail. Sign-in one-time codes and settlement emails both depend on this,
# so the app will not work correctly until real credentials are set.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="affiliates@pitchinnovations.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Affiliate dashboard business rules (spec sections 5.2 / 5.5) ---
# Percentages are expressed as decimals: 0.18 == 18%.
AFFILIATE_GST_RATE=0.18
AFFILIATE_TRANSACTION_FEE_RATE=0.05

# Sign-in one-time code (spec section 3)
AFFILIATE_OTP_TTL_MINUTES=10
AFFILIATE_OTP_MAX_ATTEMPTS=5

# Idle timeout in minutes, keep in step with SESSION_LIFETIME (spec section 3)
AFFILIATE_IDLE_TIMEOUT_MINUTES=20

# How often the live dashboard polls for new orders, in seconds (spec section 5.6)
AFFILIATE_POLL_SECONDS=5
