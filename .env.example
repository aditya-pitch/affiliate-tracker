APP_NAME="Pitch Innovations Affiliates"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=affiliate_tracker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=20
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail -------------------------------------------------------------------
# Nobody can sign in until this works: the one-time code is emailed, and it is
# a required step. Verify it before you rely on it:
#
#     php artisan mail:verify
#
# MAIL_MAILER=log writes emails to storage/logs/laravel.log instead of sending
# them. Fine for local development, useless in production.
MAIL_MAILER=log

# Typical settings for a hosted mailbox. Ask your mail provider for these.
# For Google Workspace use smtp.gmail.com:587 with an App Password (not the
# account password). For Zoho use smtp.zoho.in:587.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls

# The From address must be one your provider is allowed to send as, or mail
# will be silently binned as spam.
MAIL_FROM_ADDRESS="affiliates@pitchinnovations.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Our team -----------------------------------------------------------------
# The internal account. Sign-in codes for the admin, and the operational
# updates (invoice uploaded, sale closed, payment recorded), go here.
ADMIN_EMAIL=adityapahuja@pitchinnovations.com
ADMIN_NAME="Pitch Innovations Team"
ADMIN_ALERTS_ENABLED=true

# --- Affiliate dashboard business rules (spec sections 5.2 / 5.5) ---
# Percentages are expressed as decimals: 0.18 == 18%.
AFFILIATE_GST_RATE=0.18
AFFILIATE_TRANSACTION_FEE_RATE=0.05

# Sign-in one-time code (spec section 3)
AFFILIATE_OTP_TTL_MINUTES=10
AFFILIATE_OTP_MAX_ATTEMPTS=5

# Idle timeout in minutes, keep in step with SESSION_LIFETIME (spec section 3)
AFFILIATE_IDLE_TIMEOUT_MINUTES=20

# How often the live dashboard polls for new orders, in seconds (spec section 5.6)
AFFILIATE_POLL_SECONDS=5
